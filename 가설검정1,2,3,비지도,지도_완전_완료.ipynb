    "import random\n",
    "\n",
    "unique_clusters_8 = sorted([c for c in df['cluster_id'].unique() if c != -1])\n",
    "\n",
    "print(f\"### 군집별 대표 샘플 리포트 (K={optimal_k_8}) ###\\n\")\n",
    "\n",
    "for cluster_id in unique_clusters_8:\n",
    "    cluster_df = df[df['cluster_id'] == cluster_id]\n",
    "    data_count = len(cluster_df)\n",
    "    average_rating = cluster_df['개별평점'].mean()\n",
    "\n",
    "    print(f\"--- 군집 번호: {cluster_id} ---\")\n",
    "    print(f\"  데이터 개수: {data_count}개\")\n",
    "    print(f\"  평균 평점: {average_rating:.2f}점\")\n",
    "\n",
    "    #무작위 샘플링\n",
    "    num_samples = min(data_count, random.randint(5, 10))\n",
    "    sample_reviews = random.sample(cluster_df['서술평'].tolist(), num_samples)\n",
    "\n",
    "    print(\"  무작위 서술평 샘플:\")\n",
    "    for i, review in enumerate(sample_reviews):\n",
    "        print(f\"    {i+1}. {review[:100]}...\") \n",
    "    print(\"\\n\")\n",
    "\n",
    "print(\"노이즈 데이터가 없습니다.\")"
