    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from kss import split_sentences\n",
    "import warnings\n",
    "\n",
    "# 1. 환경 설정 및 데이터 준비\n",
    "warnings.filterwarnings('ignore')\n",
    "plt.rcParams['font.family'] = 'Malgun Gothic'\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# 분석 대상 데이터 복사 (군집 7 제외)\n",
    "df_hypo3 = df[df['cluster_id'] != 7].copy()\n",
    "score_col = '개별평점'\n",
    "\n",
    "# 2. KSS 기반 문장 단위 분리 및 데이터 재구성\n",
    "def process_to_sentences(df, text_col='서술평', score_col='개별평점'):\n",
    "    sentence_list = []\n",
    "    for idx, row in df.iterrows():\n",
    "        review_text = str(row[text_col])\n",
    "        sentences = split_sentences(review_text)\n",
    "        for sent in sentences:\n",
    "            sentence_list.append({\n",
    "                'sentence': sent,\n",
    "                'score': row[score_col],\n",
    "                'cluster_id': row['cluster_id']\n",
    "            })\n",
    "    return pd.DataFrame(sentence_list)\n",
    "\n",
    "print(\"--- [Step 1] KSS 문장 분리 진행 중... ---\")\n",
    "df_sent = process_to_sentences(df_hypo3)\n",
    "\n",
    "# 3. 문장 단위 실시간 감성 라벨링\n",
    "# 한 문장에서 긍정이 더 많으면 긍정으로, 부정이 더 많으면 부정으로\n",
    "# 여러 문장에서는 긍,부정이 잘 바뀌지만 한 문장에서 긍,부정이 바뀌긴 쉽지 않음.\n",
    "# 즉 KSS로 문장 단위로 나누고 긍/부정 counting을 함.\n",
    "def label_sent_sentiment(text):\n",
    "    pos_count = sum(1 for term in positive_terms if term in text)\n",
    "    neg_count = sum(1 for term in negative_terms if text.find(term) != -1)\n",
    "    if neg_count > pos_count: return 'negative'\n",
    "    elif pos_count > neg_count: return 'positive'\n",
    "    else: return 'neutral'\n",
    "\n",
    "df_sent['sentiment'] = df_sent['sentence'].apply(label_sent_sentiment)\n",
    "\n",
    "# 4. 가설 검정용 데이터 필터링 (3점 제외)\n",
    "# - 부정 문장 그룹: 텍스트는 부정적 & 실제 평점은 1, 2점\n",
    "# - 긍정 문장 그룹: 텍스트는 긍정적 & 실제 평점은 4, 5점\n",
    "neg_group = df_sent[(df_sent['sentiment'] == 'negative') & (df_sent['score'].isin([1.0, 2.0]))]\n",
    "pos_group = df_sent[(df_sent['sentiment'] == 'positive') & (df_sent['score'].isin([4.0, 5.0]))]\n",
    "\n",
    "# 5. 통계 분석 수행 (카이제곱 적합도 검정)\n",
    "print(\"\\n--- [Step 2] 가설 검정 결과 (3점 제외) ---\")\n",
    "\n",
    "# (A) 부정 그룹 분석\n",
    "obs_neg_1 = len(neg_group[neg_group['score'] == 1.0])\n",
    "obs_neg_2 = len(neg_group[neg_group['score'] == 2.0])\n",
    "chi_n, p_n = stats.chisquare([obs_neg_1, obs_neg_2])\n",
    "\n",
    "print(f\"[부정 문장 구간 (1점 vs 2점)]\")\n",
    "print(f\" - 1점(징벌적): {obs_neg_1}건 / 2점(이성적): {obs_neg_2}건\")\n",
    "print(f\" - P-value: {p_n:.4f} ({'유의미한 차이' if p_n < 0.05 else '차이 없음'})\")\n",
    "\n",
    "# (B) 긍정 그룹 분석\n",
    "obs_pos_5 = len(pos_group[pos_group['score'] == 5.0])\n",
    "obs_pos_4 = len(pos_group[pos_group['score'] == 4.0])\n",
    "chi_p, p_p = stats.chisquare([obs_pos_5, obs_pos_4])\n",
    "\n",
    "print(f\"\\n[긍정 문장 구간 (5점 vs 4점)]\")\n",
    "print(f\" - 5점(전폭적): {obs_pos_5}건 / 4점(우호적): {obs_pos_4}건\")\n",
    "print(f\" - P-value: {p_p:.4f} ({'유의미한 쏠림' if p_p < 0.05 else '차이 없음'})\")\n",
    "\n",
    "# 6. 시각화\n",
    "plt.figure(figsize=(12, 7))\n",
    "\n",
    "plot_data = pd.DataFrame({\n",
    "    '분석 그룹': ['부정 문장', '부정 문장', '긍정 문장', '긍정 문장'],\n",
    "    '평점 유형': ['1점(최저점)', '2점(감점)', '5점(만점)', '4점(고점)'],\n",
    "    '문장 수': [obs_neg_1, obs_neg_2, obs_pos_5, obs_pos_4]\n",
    "})\n",
    "\n",
    "sns.barplot(data=plot_data, x='분석 그룹', y='문장 수', hue='평점 유형', palette='RdYlBu_r')\n",
