    "import json\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import os\n",
    "\n",
    "# =========================================================\n",
    "# [주의] 이 코드를 실행하기 전에 아래 변수들이 메모리에 있어야 합니다.\n",
    "# 1. df (3개 미만 강의가 정제된 최신 데이터프레임)\n",
    "# 2. X_770 (스케일링된 리뷰 길이와 평점이 추가된 770차원 넘파이 배열)\n",
    "# 3. model_770 (770차원 데이터로 학습을 마친 최종 모델)\n",
    "# =========================================================\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 1. 환경 설정\n",
    "# ---------------------------------------------------------\n",
    "cluster_tag_map = {\n",
    "    0: '#학점_주의',      \n",
    "    1: '#난이도_높음',    \n",
    "    2: '#팀플_위주',      \n",
    "    3: '#꿀강',         \n",
    "    4: '#합리적_평가',   \n",
    "    5: '#실습_알찬수업',  \n",
    "    6: '#강의력_최고',    \n",
    "    7: '#기타_리뷰'      \n",
    "}\n",
    "\n",
    "lecture_json = {}\n",
    "    #강의평 3개 미만이면 강의평_부족 태깅.\n",
    "try:\n",
    "    raw_df = pd.read_csv('khu_all_reviews_accumulated.csv')\n",
    "    raw_counts = raw_df['강의명'].value_counts()\n",
    "    insufficient_lectures = raw_counts[raw_counts < 3].index.tolist()\n",
    "    \n",
    "    for lec in insufficient_lectures:\n",
    "        lecture_json[lec] = \"#강의평_부족\"\n",
    "    print(f\"📉 강의평 3개 미만 강의 {len(insufficient_lectures)}개 사전에 '#강의평_부족' 등록 완료.\")\n",
    "except Exception:\n",
    "    print(\"ℹ️ 원본 파일 참조 불가로 기존 필터링 로직만 가동합니다. (필요 시 파일명을 맞춰주세요)\")\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 2. 강의별 가설 반영 태깅 및 집계 로직 (양질의 강의 대상)\n",
    "# ---------------------------------------------------------\n",
    "grouped = df.groupby('강의명')\n",
    "\n",
    "print(f\"🏷️ 강의별 770차원 모델 기반 태깅 작업 시작\")\n",
    "\n",
    "for lecture_name, group in grouped:\n",
    "    # 혹시라도 걸러지지 않은 3개 이하 항목이 있다면 여기서 한 번 더 방어해 줍니다.\n",
    "    if len(group) < 3:\n",
    "        lecture_json[lecture_name] = \"#강의평_부족\"\n",
    "        continue\n",
    "        \n",
    "    all_tags = []\n",
    "    \n",
    "    for idx in group.index:\n",
    "        num_idx = df.index.get_loc(idx)\n",
    "        feature_vector = X_770[num_idx].reshape(1, -1)\n",
    "        raw_probs = model_770.predict_proba(feature_vector)[0]\n",
    "            \n",
    "        # 확률이 0.3 이상이면 태그를 부여합니다.\n",
    "        tags = [cluster_tag_map[i] for i, prob in enumerate(raw_probs) if prob >= 0.3]\n",
    "    \n",
    "        #여기서 최빈값으로\n",
    "        if not tags:\n",
    "            best_idx = np.argmax(raw_probs)\n",
    "            tags = [cluster_tag_map[best_idx]]\n",
    "            \n",
    "        all_tags.extend(tags)\n",
    "   \n",
    "    # 강의별 태그 집계 및 비율 계산 (30% 기준 + 최빈값 로직)\n",
    "    #여기서 30%란?\n",
    "    #=> 클래스 레이블 다는 임계치 30%가 아니라, 내 N번째 클러스터링이 전체 클러스터링 중 얼마나 차지하냐?\n",
    "    #즉 한 강의에 1번 레이블 5개, 2번 레이블 3개, 3번 레이블 2개의 강의평이있다면,\n",
    "    # 1번 레이블은 50% 2번 레이블은 30% 3번 레이블은 20%이므로, 1,2번 레이블을 태깅함.\n",
    "    #이것이 ㄹㅇ 정보제공임!!\n",
    "    #다만 여기서 모든 레이블이 30%가 넘지 못하는 아쉬운 강의들이 있을 것.\n",
    "    #이를 대비하여 모두 30%가 넘지 못하면 최빈값으로 대체함.\n",
    "    #어차피 강의평 3개 미만은 #강의평_부족으로 먼저 전처리 하였기 때문.\n",
    "\n",
    "    tag_series = pd.Series(all_tags).value_counts()\n",
    "    total_reviews = len(group)\n",
    "        \n",
    "    # 1. 먼저 30% 이상 등장한 굳건한 태그들을 필터링합니다.\n",
    "    selected_tags = [tag for tag, count in tag_series.items() if (count / total_reviews) >= 0.30]\n",
    "        \n",
    "    if selected_tags:\n",
    "        # 30% 넘는 태그가 있다면 공백으로 연결해서 등록 (예: \"#꿀강 #강의력_최고\")\n",
    "        lecture_json[lecture_name] = \" \".join(selected_tags)\n",
    "    else:\n",
    "        most_frequent_tag = tag_series.index[0]\n",
    "        lecture_json[lecture_name] = most_frequent_tag\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 3. 파일 저장 \n",
    "# ---------------------------------------------------------\n",
    "file_name = 'lecture_tags.json'\n",
    "\n",
    "with open(file_name, 'w', encoding='utf-8') as f:\n",
    "    json.dump(lecture_json, f, ensure_ascii=False, indent=4)\n",
    "\n",
    "print(f\"✅ JSON 생성 완료: {os.path.abspath(file_name)}\")\n",
    "\n",
    "try:\n",
    "    from google.colab import files\n",
    "    files.download(file_name)\n",
    "    print(\"📥 다운로드가 시작됩니다.\")\n",
    "except ImportError:\n",
    "    print(f\"📂 '{file_name}' 파일이 로컬 디렉토리에 저장되었습니다.\")"
   ]
  },
