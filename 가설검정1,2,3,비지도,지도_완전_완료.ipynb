    "import pandas as pd\n",
    "import numpy as np\n",
    "from lightgbm import LGBMClassifier\n",
    "from sklearn.model_selection import train_test_split, GridSearchCV\n",
    "from sklearn.multiclass import OneVsRestClassifier\n",
    "from sklearn.metrics import classification_report, f1_score, precision_score, recall_score, make_scorer\n",
    "from sklearn.preprocessing import MultiLabelBinarizer, MinMaxScaler\n",
    "from sklearn.metrics import jaccard_score, hamming_loss, accuracy_score, top_k_accuracy_score\n",
    "\n",
    "# =========================================================================\n",
    "# [전처리] 신뢰도 확보를 위한 강의당 최소 강의평 수(3개 이상) 필터링\n",
    "# =========================================================================\n",
    "lecture_column = '강의명' \n",
    "\n",
    "print(\"🧹 데이터 신뢰도 검증을 위한 전처리 중...\")\n",
    "print(f\" - 필터링 전 전체 강의평 수: {len(df)}개\")\n",
    "\n",
    "# 1. 각 강의당 강의평 개수 계산\n",
    "lecture_counts = df[lecture_column].value_counts()\n",
    "\n",
    "\n",
    "# 2. 강의평 개수가 3개 이상인 강의의 인덱스만 추출\n",
    "valid_lectures = lecture_counts[lecture_counts >= 3].index\n",
    "\n",
    "keep_mask = df[lecture_column].isin(valid_lectures)\n",
    "\n",
    "# 4. 데이터프레임과 임베딩 배열을 동시에 필터링하여 인덱스 싱크 맞추기\n",
    "embeddings = embeddings[keep_mask]\n",
    "df = df[keep_mask].reset_index(drop=True)\n",
    "\n",
    "print(f\" - 필터링 후 남은 최종 강의평 수: {len(df)}개\")\n",
    "print(f\" - 신뢰도 미달(3개 미만)로 제거된 강의평 수: {np.sum(~keep_mask)}개\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 0. 준비 및 정답 데이터 이진화\n",
    "# ---------------------------------------------------------\n",
    "mlb = MultiLabelBinarizer()\n",
    "y_bin = mlb.fit_transform([[label] for label in df['cluster_id']])\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 1. Feature Engineering (가설 데이터를 770차원으로 결합)\n",
    "# ---------------------------------------------------------\n",
    "print(\"🧩 770차원 가설 기반 Feature 생성 중...\")\n",
    "#가설검정2의 리뷰 길이 이용\n",
    "review_lengths = df['서술평'].astype(str).apply(len).values.reshape(-1, 1)\n",
    "#가설검정3의 별점이 낮을 수록 강의 특징을 많이 표현을 5 - 별점으로 역의 관계를 취했어요.\n",
    "inverted_ratings = (5.0 - df['개별평점'].values).reshape(-1, 1)\n",
    "\n",
    "scaler = MinMaxScaler(feature_range=(-1, 1))\n",
    "extra_features_scaled = scaler.fit_transform(np.hstack((review_lengths, inverted_ratings)))\n",
    "\n",
    "X_770 = np.hstack((embeddings, extra_features_scaled))\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 2. Train / Test 데이터 분리 (두 모델 모두 동일한 분할 사용)\n",
    "# ---------------------------------------------------------\n",
    "#모델이 MultilabelBinarizer입니다.\n",
    "#즉 8개의 레이블을 8-fold로 학습하는 것이 아닌, 그냥 학습하면 됩니다.\n",
    "#이 모델은 각 레이블이 1(맞다), 0(아니다)로 판단하기에 계속 8개의 레이블을 학습한다고 할 수 있습니다.\n",
    "#데이터 셋은 2개로 나눴습니다.\n",
    "#768차원짜리랑 770차원짜리로 \n",
    "X_train_base, X_test_base, y_train, y_test = train_test_split(\n",
    "    embeddings, y_bin, test_size=0.2, random_state=42, stratify=None\n",
    ")\n",
    "\n",
    "X_train_770, X_test_770, _, _ = train_test_split(\n",
    "    X_770, y_bin, test_size=0.2, random_state=42, stratify=None\n",
    ")\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 3. [STEP 1] Baseline(768차원) 최적화를 위한 그리드 서치 루프\n",
    "# ---------------------------------------------------------\n",
    "print(\"\\n🔥 [STEP 1] Baseline 모델의 최적 하이퍼파라미터 및 임계치 서치 시작...\")\n",
    "\n",
    "cutoff_candidates = [0.3, 0.4]\n",
    "param_grid = {\n",
    "    'estimator__max_depth': [3, 5],\n",
    "    'estimator__num_leaves': [15, 31],\n",
    "    'estimator__learning_rate': [0.05]\n",
    "}\n",
    "#초기 하이퍼파라미터값\n",
    "#여기서 더 좋은 모델 그리드 서치로 찾으면 그값으로 \n",
    "best_score_base = -1\n",
    "best_grid_results_base = None\n",
    "BEST_CUT_OFF = 0.4\n",
    "\n",
    "for cutoff in cutoff_candidates:\n",
    "    print(f\" 🔍 Baseline - 임계치(Cut-off): {cutoff} 세팅에서 모델 탐색 중...\")\n",
    "    \n",
    "    def make_custom_scorer(th):\n",
    "        def custom_f1(y_true, y_probs):\n",
    "            preds = (y_probs >= th).astype(int)\n",
    "            return f1_score(y_true, preds, average='micro')\n",
    "        return make_scorer(custom_f1, response_method=\"predict_proba\")\n",
    "    \n",
    "    scorer = make_custom_scorer(cutoff)\n",
    "    \n",
    "    base_lgbm = LGBMClassifier(n_estimators=100, random_state=42, verbose=-1, n_jobs=1)\n",
    "    base_ovr = OneVsRestClassifier(base_lgbm)\n",
    "    grid_base = GridSearchCV(base_ovr, param_grid, cv=5, scoring=scorer, n_jobs=-1)\n",
    "    grid_base.fit(X_train_base, y_train)\n",
    "    \n",
    "    if grid_base.best_score_ > best_score_base:\n",
    "        best_score_base = grid_base.best_score_\n",
    "        best_grid_results_base = grid_base\n",
    "        BEST_CUT_OFF = cutoff\n",
    "\n",
    "optimal_params_from_base = best_grid_results_base.best_params_\n",
    "model_base = best_grid_results_base.best_estimator_\n",
    "\n",
    "print(\"\\n📊 [그리드 서치 완료 및 설정 고정]\")\n",
    "clean_params = {k.replace('estimator__', ''): v for k, v in optimal_params_from_base.items()}\n",
    "print(f\" 📌 고정된 최적 하이퍼파라미터: {clean_params}\")\n",
    "print(f\" 📌 고정된 최적 임계치(Cut-off): {BEST_CUT_OFF} (Baseline CV 최고점수: {best_score_base:.4f})\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 3. [STEP 2] 가설 반영 모델(770차원)에 '동일한 최적 설정' 주입하여 학습\n",
    "# ---------------------------------------------------------\n",
    "print(\"\\n🚀 [STEP 2] 고정된 최적 설정으로 가설 반영 모델(770차원) 학습 중...\")\n",
    "\n",
    "pure_lgbm_params = {k.replace('estimator__', ''): v for k, v in optimal_params_from_base.items()}\n",
    "\n",
    "lgbm_770 = LGBMClassifier(n_estimators=100, random_state=42, verbose=-1, n_jobs=1, **pure_lgbm_params)\n",
    "model_770 = OneVsRestClassifier(lgbm_770)\n",
    "model_770.fit(X_train_770, y_train)\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 4. 공정한 성능 평가 (고정된 동일 임계치 BEST_CUT_OFF 적용)\n",
    "# ---------------------------------------------------------\n",
    "probs_base = model_base.predict_proba(X_test_base)\n",
    "probs_770 = model_770.predict_proba(X_test_770)\n",
    "\n",
    "preds_base = (probs_base >= BEST_CUT_OFF).astype(int)\n",
    "preds_770 = (probs_770 >= BEST_CUT_OFF).astype(int)\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# 5. 최종 성능 비교 리포트\n",
    "# ---------------------------------------------------------\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(f\"🎯 [최종 검증 리포트] 가설 추가에 따른 순수 성능 변화 (공통 임계치: {BEST_CUT_OFF})\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "jaccard_base = jaccard_score(y_test, preds_base, average='samples')\n",
    "jaccard_770 = jaccard_score(y_test, preds_770, average='samples')\n",
    "\n",
    "exact_base = accuracy_score(y_test, preds_base)\n",
    "exact_770 = accuracy_score(y_test, preds_770)\n",
    "\n",
    "hamming_base = hamming_loss(y_test, preds_base)\n",
    "hamming_770 = hamming_loss(y_test, preds_770)\n",
    "\n",
    "print(f\"[1] Jaccard Score (태그 일치율 - 높을수록 좋음)\")\n",
    "print(f\" - Baseline (768) : {jaccard_base:.4f}\")\n",
    "print(f\" - 가설 반영 (770): {jaccard_770:.4f}\")\n",
    "if jaccard_770 > jaccard_base:\n",
    "    print(f\"   => 💡 가설 피처 추가로 리뷰당 정답 태그 일치율이 {(jaccard_770 - jaccard_base):.4f} 상승했습니다! 가설 검증 성공! 🎉\\n\")\n",
    "elif jaccard_770 < jaccard_base:\n",
    "    print(f\"   => 🤔 가설 피처 추가 후 오히려 {(jaccard_base - jaccard_770):.4f} 하락했습니다. 피처 정제나 모델 튜닝이 더 필요합니다.\\n\")\n",
    "else:\n",
    "    print(\"   => ⚖️ 가설 피처 추가 전후의 성능이 완전히 동일합니다.\\n\")\n",
    "\n",
    "print(f\"[2] Exact Match Ratio (완벽 일치율 - 높을수록 좋음)\")\n",
    "print(f\" - Baseline (768) : {exact_base:.4f}\")\n",
    "print(f\" - 가설 반영 (770): {exact_770:.4f}\")\n",
    "if exact_770 > exact_base:\n",
    "    print(f\"   => 💡 모든 태그를 100% 완벽하게 맞춘 비율이 {(exact_770 - exact_base):.4f} 상승했습니다!\\n\")\n",
    "elif exact_770 < exact_base:\n",
    "    print(f\"   => 🤔 모든 태그를 100% 완벽하게 맞춘 비율이 {(exact_base - exact_770):.4f} 하락했습니다.\\n\")\n",
    "else:\n",
    "    print(\"   => ⚖️ 완벽 일치율이 동일합니다.\\n\")\n",
    "\n",
    "print(f\"[3] Hamming Loss (태그 오답률 - 낮을수록 좋음 🔽)\")\n",
    "print(f\" - Baseline (768) : {hamming_base:.4f}\")\n",
    "print(f\" - 가설 반영 (770): {hamming_770:.4f}\")\n",
    "if hamming_770 < hamming_base:\n",
    "    print(f\"   => 💡 전체 태그 에러율이 {(hamming_base - hamming_770):.4f} 감소했습니다!\")\n",
    "elif hamming_770 > hamming_base:\n",
    "    print(f\"   => 🤔 전체 태그 에러율이 {(hamming_770 - hamming_base):.4f} 증가했습니다.\")\n",
    "\n",
    "# 다중 레이블 태깅하기에 top k auccrucy \n",
    "# 아래 셀 코드를 보면 0.3 기준으로 태깅하니 한 강의에 최대 3개까지 태깅이 됩니다.\n",
    "# 그래서 top 3 어큐러시 태깅 성능 지표 출력햇어욥.\n",
    "y_test_labels = np.argmax(y_test, axis=1)\n",
    "print(f\"\\n[4] Top-K Accuracy (상위 K개 내 정답 포함율)\")\n",
    "for k in [1, 2, 3]:\n",
    "    b = top_k_accuracy_score(y_test_labels, probs_base, k=k)\n",
    "    n = top_k_accuracy_score(y_test_labels, probs_770, k=k)\n",
    "    print(f\" - Top-{k} | Base: {b:.4f} vs 가설: {n:.4f} | 차이: {(n-b):+.4f}\")\n",
    "print(\"=\"*60)"
   ]
