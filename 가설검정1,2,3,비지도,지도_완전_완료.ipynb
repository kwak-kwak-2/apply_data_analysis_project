   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "import kss\n",
    "\n",
    "# 1. 감성 사전 \n",
    "positive_terms = [\n",
    "    '좋다', '좋았', '최고', '친절', '만족', '추천', '도움', '유익', '열정', '꼼꼼', \n",
    "    '이해', '쉬움', '명확', '수월', '배려', '잘함', '흥미', '편함', '자유', '재미', \n",
    "    '배움', '발전', '소통', '훌륭', '칭찬', '든든', '감사', '유용', '알찬', '확실', \n",
    "    '가능', '적절', '부드럽', '후함', '쉽게', '재미있', '도움이', '깔끔', '완벽', \n",
    "    '정확', '효율', '성장', '긍정적', '명쾌', '보람', '꿀', '혜자', '갓', '좋음', \n",
    "    '편안', '너그럽', '좋으심', '유익함', '재밌', '깔끔함'\n",
    "]\n",
    "\n",
    "negative_terms = [\n",
    "    '나쁘다', '불친절', '어렵', '힘들', '최악', '불명확', '모호', '부족', '지루', '부담', \n",
    "    '별로', '고통', '짜증', '시간 낭비', '개판', '횡설수설', '두서없', '이해 안', '못함', \n",
    "    '날먹', '불쾌', '불만', '불합리', '과도', '까다롭', '불가능', '어려움', '힘듦', '아쉬움', \n",
    "    '불편', '답답', '부정적', '복잡', '불분명', '애매', '개선', '고생', '피곤', '빡셈', \n",
    "    '헬', '노답', '극악', '최악', '아쉬움', '망함', '힘듦', '지옥', '어려움'\n",
    "]\n",
    "\n",
    "# 2. [핵심] 긍부정 단어 개수 비교 함수\n",
    "def analyze_keyword_sentiment_with_kss(row, keyword):\n",
    "    results = []\n",
    "    text = str(row['서술평'])\n",
    "    rating = row['개별평점']\n",
    "    \n",
    "    try:\n",
    "        sentences = kss.split_sentences(text)\n",
    "        for sentence in sentences:\n",
    "            if keyword in sentence:\n",
    "                # 1. 문장 내 긍정/부정 단어 개수 카운트\n",
    "                pos_count = sum(1 for term in positive_terms if term in sentence)\n",
    "                neg_count = sum(1 for term in negative_terms if term in sentence)\n",
    "                \n",
    "                # 2. 확실히 차이가 날 때만 저장 (같으면 버림)\n",
    "                if pos_count > neg_count:\n",
    "                    results.append(('positive', rating))\n",
    "                elif neg_count > pos_count:\n",
    "                    results.append(('negative', rating))\n",
    "    except:\n",
    "        pass\n",
    "    return results\n",
    "# 3. 분석 키워드 (22개)\n",
    "top_keywords_manual = [\n",
    "    '교수', '시험', '과제', '문제', '성적', '공부', '학점', '설명', \n",
    "    '시간', '중간', '발표', '이해', '점수', '학생', '프로젝트', \n",
    "    '자료', '추천', '부담', '출석', '퀴즈', '실습', '질문'\n",
    "]\n",
    "\n",
    "# 4. 분석 루프 실행\n",
    "keyword_results = []\n",
    "for keyword in top_keywords_manual:\n",
    "    all_matched_sentiments = []\n",
    "    target_reviews = df_analysis[df_analysis['서술평'].str.contains(keyword, na=False)]\n",
    "    \n",
    "    for _, row in target_reviews.iterrows():\n",
    "        all_matched_sentiments.extend(analyze_keyword_sentiment_with_kss(row, keyword))\n",
    "    \n",
    "    pos_ratings = [r[1] for r in all_matched_sentiments if r[0] == 'positive']\n",
    "    neg_ratings = [r[1] for r in all_matched_sentiments if r[0] == 'negative']\n",
    "\n",
    "    if len(pos_ratings) > 0 and len(neg_ratings) > 0:\n",
    "        impact_score = abs(np.mean(pos_ratings) - np.mean(neg_ratings))\n",
    "        keyword_results.append({\n",
    "            '키워드': keyword,\n",
    "            '문장단위_언급횟수': len(all_matched_sentiments),\n",
    "            '영향력지표(격차)': round(impact_score, 4)\n",
    "        })\n",
    "\n",
    "# 5. 최종 데이터프레임 및 상관분석\n",
    "final_impact_df = pd.DataFrame(keyword_results)\n",
    "display(final_impact_df.sort_values(by='문장단위_언급횟수', ascending=False))\n",
    "\n",
    "if len(final_impact_df) >= 2:\n",
    "    correlation, p_value = stats.pearsonr(final_impact_df['문장단위_언급횟수'], final_impact_df['영향력지표(격차)'])\n",
    "    print(f\"\\n✅ [가설 1 검증 완료]\")\n",
    "    print(f\"📈 상관계수(r): {correlation:.4f}\")\n",
    "    print(f\"💡 P-value: {p_value:.4f}\")"
   ]
