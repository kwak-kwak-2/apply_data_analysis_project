    "import pandas as pd\n",
    "from scipy import stats\n",
    "import numpy as np\n",
    "\n",
    "# 1. 데이터 필터링 (군집 7 제외)\n",
    "df_len_analysis = df[df['cluster_id'] != 7].copy()\n",
    "\n",
    "# 2. 강의평 길이 계산\n",
    "df_len_analysis['review_length'] = df_len_analysis['서술평'].apply(lambda x: len(str(x)) if pd.notna(x) else 0)\n",
    "\n",
    "# 3. 사분위수(Quantile) 기준 상/하위 25% 추출\n",
    "q3 = df_len_analysis['review_length'].quantile(0.75)\n",
    "q1 = df_len_analysis['review_length'].quantile(0.25)\n",
    "\n",
    "long_reviews = df_len_analysis[df_len_analysis['review_length'] >= q3]\n",
    "short_reviews = df_len_analysis[df_len_analysis['review_length'] <= q1]\n",
    "\n",
    "# 평점 데이터 추출\n",
    "score_col = '개별평점'  \n",
    "ratings_long = long_reviews[score_col]\n",
    "ratings_short = short_reviews[score_col]\n",
    "\n",
    "# 4. 양측 검정(Two-sided Welch's t-test) 수행\n",
    "print(f\"--- [가설 2] 리뷰 길이에 따른 평점 차이 검정 (양측 T-test) ---\")\n",
    "print(f\"Long 그룹 (상위 25%, {q3:.0f}자 이상) 샘플 수: {len(ratings_long)}\")\n",
    "print(f\"Short 그룹 (하위 25%, {q1:.0f}자 이하) 샘플 수: {len(ratings_short)}\")\n",
    "\n",
    "if len(ratings_long) >= 2 and len(ratings_short) >= 2:\n",
    "    # alternative='two-sided': 두 그룹의 평균이 '다르다'는 가설 검정\n",
    "    t_stat, p_val_two_tailed = stats.ttest_ind(ratings_long, ratings_short, \n",
    "                                               equal_var=False, \n",
    "                                               alternative='two-sided')\n",
    "    \n",
    "    avg_long = ratings_long.mean()\n",
    "    avg_short = ratings_short.mean()\n",
    "    \n",
    "    print(f\"\\n[분석 결과]\")\n",
    "    print(f\"✔ 긴 리뷰 평균 평점: {avg_long:.2f}점\")\n",
    "    print(f\"✔ 짧은 리뷰 평균 평점: {avg_short:.2f}점\")\n",
    "    print(f\"✔ 평균 평점 차이: {abs(avg_long - avg_short):.2f}점\")\n",
    "    print(f\"✔ t-statistic: {t_stat:.4f}\")\n",
    "    print(f\"✔ Two-tailed P-value: {p_val_two_tailed:.4f}\")\n",
    "\n",
    "    # 5. 가설 판정\n",
    "    alpha = 0.05\n",
    "    print(f\"\\n[가설 판정 (유의수준 {alpha})]\")\n",
    "    if p_val_two_tailed < alpha:\n",
    "        print(f\"✅ 결과: P-value({p_val_two_tailed:.4f}) < {alpha}\")\n",
    "        print(\"👉 판정: 귀무가설(H0)을 기각하고 대립가설(H1)을 채택합니다.\")\n",
    "        print(\"👉 결론: 강의평 길이에 따라 평균 평점의 차이가 통계적으로 유의미하게 나타납니다.\")\n",
    "    else:\n",
    "        print(f\"❌ 결과: P-value({p_val_two_tailed:.4f}) >= {alpha}\")\n",
    "        print(\"👉 판정: 귀무가설(H0)을 기각하지 못합니다.\")\n",
    "        print(\"👉 결론: 강의평 길이에 따른 평점 차이는 통계적으로 유의미하지 않습니다.\")\n",
    "else:\n",
    "    print(\"샘플 데이터 부족으로 분석 불가\")"
