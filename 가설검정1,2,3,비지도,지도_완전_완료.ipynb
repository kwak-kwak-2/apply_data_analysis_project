    "import sys\n",
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "\n",
    "# 1. UMAP 설치 및 라이브러리 로드\n",
    "if 'umap' not in sys.modules:\n",
    "    !pip install umap-learn\n",
    "\n",
    "from umap import UMAP\n",
    "\n",
    "try:\n",
    "    # 2. UMAP을 사용하여 임베딩을 2차원으로 축소\n",
    "    print(\"UMAP 차원 축소 계산 중...\")\n",
    "    reducer = UMAP(n_neighbors=15, n_components=2, metric='cosine', random_state=42)\n",
    "    umap_embeddings = reducer.fit_transform(embeddings)\n",
    "\n",
    "    # 3. 좌표를 데이터프레임에 추가\n",
    "    df['UMAP_X'] = umap_embeddings[:, 0]\n",
    "    df['UMAP_Y'] = umap_embeddings[:, 1]\n",
    "    df['cluster_id_str'] = df['cluster_id'].astype(str)\n",
    "\n",
    "    # 4. Plotly 시각화\n",
    "    fig = px.scatter(\n",
    "        df,\n",
    "        x='UMAP_X',\n",
    "        y='UMAP_Y',\n",
    "        color='cluster_id_str',\n",
    "        hover_data={'서술평': True, '개별평점': True, 'cluster_id': True},\n",
    "        title='K-Means Clustering (K=8) of Review Embeddings (UMAP 2D Projection)',\n",
    "        labels={'UMAP_X': 'UMAP Component 1', 'UMAP_Y': 'UMAP Component 2'},\n",
    "        height=700\n",
    "    )\n",
    "\n",
    "    fig.update_layout(hovermode='closest')\n",
    "    fig.show()\n",
    "\n",
    "except NameError as e:\n",
    "    print(f\"오류 발생: {e}. 'embeddings' 또는 'df' 변수가 정의되지 않았습니다. 상단 셀들을 먼저 실행해 주세요.\")\n",
    "except Exception as e:\n",
    "    print(f\"예기치 않은 오류 발생: {e}\")"
   ]
