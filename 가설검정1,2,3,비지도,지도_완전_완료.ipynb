   "source": [
    "from sklearn.cluster import KMeans\n",
    "import numpy as np\n",
    "\n",
    "# 1. K-Means 모델 생성 및 예측 (기존과 동일)\n",
    "optimal_k_8 = 8\n",
    "kmeans_model_8 = KMeans(n_clusters=optimal_k_8, random_state=42, n_init=10)\n",
    "df['cluster_id'] = kmeans_model_8.fit_predict(embeddings)\n",
    "\n",
    "# 2. 각 클러스터별 평균 평점 계산\n",
    "cluster_means = df.groupby('cluster_id')['개별평점'].mean().sort_values()\n",
    "\n",
    "# 3. 평균 평점이 낮은 순서대로 새로운 ID(0~7) 매핑 딕셔너리 생성\n",
    "# 예: 평점 가장 낮은 클러스터 -> 0, 가장 높은 클러스터 -> 7\n",
    "new_label_map = {old_id: new_id for new_id, old_id in enumerate(cluster_means.index)}\n",
    "\n",
    "# 4. 기존 cluster_id를 이 매핑을 통해 '학점 순 정렬된 ID'로 즉시 덮어쓰기\n",
    "df['cluster_id'] = df['cluster_id'].map(new_label_map)\n",
    "\n",
    "# 5. 결과 확인\n",
    "print(\"📌 학점 순으로 정렬된 클러스터 ID 할당 완료:\")\n",
    "print(\"-\" * 40)\n",
    "for new_id in range(optimal_k_8):\n",
    "    # 해당 ID를 가진 데이터들의 평균 평점 확인\n",
    "    avg_rating = df[df['cluster_id'] == new_id]['개별평점'].mean()\n",
    "    print(f\"클러스터 ID {new_id}: 평균 평점 {avg_rating:.2f}\")"
   ]
  },
