    "from collections import Counter\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# 전체 분석 대상 데이터(군집 7 제외)의 키워드 빈도 측정\n",
    "all_words_list = []\n",
    "for keywords in top_keywords_by_cluster.values():\n",
    "    for word, count in keywords:\n",
    "        # 각 단어를 빈도수만큼 리스트에 추가\n",
    "        all_words_list.extend([word] * count)\n",
    "\n",
    "# 전체 빈도 합산\n",
    "all_keywords_counter = Counter(all_words_list)\n",
    "\n",
    "# 데이터프레임으로 변환 (정렬 및 통계 처리가 용이함)\n",
    "df_total_freq = pd.DataFrame(all_keywords_counter.items(), columns=['키워드', '빈도수'])\n",
    "df_total_freq = df_total_freq.sort_values(by='빈도수', ascending=False).reset_index(drop=True)\n",
    "\n",
    "# 결과 출력\n",
    "print(\"전체 데이터 키워드 합산 빈도수 \")\n",
    "print(df_total_freq)"
   ]
