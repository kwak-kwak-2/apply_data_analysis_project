    "import sys\n",
    "\n",
    "# konlpy 설치 확인 및 설치\n",
    "if 'konlpy' not in sys.modules:\n",
    "    !pip install konlpy\n",
    "\n",
    "from konlpy.tag import Okt\n",
    "okt = Okt()\n",
    "\n",
    "# 각 군집별 키워드 추출 및 빈도 계산 함수\n",
    "def get_top_keywords_per_cluster(df, cluster_id_col, text_col, num_keywords=10):\n",
    "    cluster_keywords = {}\n",
    "    for cluster_id in sorted(df[cluster_id_col].unique()):\n",
    "        if cluster_id == -1: # 노이즈 제외 전처리\n",
    "            continue\n",
    "\n",
    "        cluster_reviews = df[df[cluster_id_col] == cluster_id][text_col].tolist()\n",
    "\n",
    "        # 형태소 분석 및 명사 추출\n",
    "        nouns = []\n",
    "        for review in cluster_reviews:\n",
    "            nouns.extend(okt.nouns(review))\n",
    "\n",
    "        # 불용어 제거 (선택적: 필요한 경우 추가)\n",
    "        #수업,강의는 모든 강의평에 다 포함되어 있어 분류가 어렵습니다.\n",
    "        stopwords = ['수업','점', '것', '내용', '진짜', '생각', '때', '말', '부분', '이', '그', '더', '좀', '정말', '과목', '강의'] # 일반적인 불용어 추가\n",
    "        filtered_nouns = [n for n in nouns if len(n) > 1 and n not in stopwords]\n",
    "\n",
    "        # 단어 빈도 계산\n",
    "        from collections import Counter\n",
    "        word_counts = Counter(filtered_nouns)\n",
    "\n",
    "        # 상위 키워드 저장\n",
    "        cluster_keywords[cluster_id] = word_counts.most_common(num_keywords)\n",
    "    return cluster_keywords\n",
    "\n",
    "# 군집별 상위 키워드 추출\n",
    "top_keywords_by_cluster = get_top_keywords_per_cluster(df, 'cluster_id', '서술평', num_keywords=15)\n",
    "\n",
    "# 결과 출력\n",
    "print(f\"### K={optimal_k_8} 군집별 핵심 키워드 리포트 ###\\n\")\n",
    "for cluster_id, keywords in top_keywords_by_cluster.items():\n",
    "    print(f\"--- 군집 번호: {cluster_id} ---\")\n",
    "    print(f\"  상위 키워드: {', '.join([f'{word}({count})' for word, count in keywords])}\")\n",
    "\n",
    "    # 해당 군집의 평균 평점 및 데이터 개수 재확인 (참고용)\n",
    "    cluster_df = df[df['cluster_id'] == cluster_id]\n",
    "    data_count = len(cluster_df)\n",
    "    average_rating = cluster_df['개별평점'].mean()\n",
    "    print(f\"  데이터 개수: {data_count}개, 평균 평점: {average_rating:.2f}점\")\n",
    "\n",
    "    # 무작위 샘플 리뷰 3개 추가로 출력\n",
    "    import random\n",
    "    sample_reviews = random.sample(cluster_df['서술평'].tolist(), min(3, data_count))\n",
    "    print(\"  대표 샘플 리뷰:\")\n",
    "    for i, review in enumerate(sample_reviews):\n",
    "        print(f\"    {i+1}. {review[:100]}...\") # Truncate for display\n",
    "    print(\"\\n\")\n"
   ]
  },
